{
  "name": "Empresa",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string"
    },
    "rut": {
      "type": "string"
    },
    "giro": {
      "type": "string"
    },
    "direccion": {
      "type": "string"
    },
    "telefono": {
      "type": "string"
    },
    "email_contacto": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "onboarding",
        "activa",
        "demo",
        "suspendida"
      ],
      "default": "onboarding"
    },
    "onboarding_paso": {
      "type": "number",
      "default": 1
    },
    "onboarding_completado": {
      "type": "boolean",
      "default": false
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "nombre"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}