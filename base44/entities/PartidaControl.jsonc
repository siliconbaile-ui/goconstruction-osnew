{
  "name": "PartidaControl",
  "type": "object",
  "properties": {
    "proyecto_id": {
      "type": "string"
    },
    "codigo": {
      "type": "string"
    },
    "nombre": {
      "type": "string"
    },
    "categoria": {
      "type": "string"
    },
    "avance_programado": {
      "type": "number",
      "default": 0
    },
    "avance_real": {
      "type": "number",
      "default": 0
    },
    "fecha_inicio_programada": {
      "type": "string",
      "format": "date"
    },
    "fecha_fin_programada": {
      "type": "string",
      "format": "date"
    },
    "fecha_inicio_real": {
      "type": "string",
      "format": "date"
    },
    "fecha_fin_real": {
      "type": "string",
      "format": "date"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "en_progreso",
        "completada",
        "bloqueada"
      ],
      "default": "pendiente"
    },
    "estado_calidad": {
      "type": "string",
      "enum": [
        "sin_inspeccion",
        "pendiente",
        "aprobado",
        "rechazado"
      ],
      "default": "sin_inspeccion"
    },
    "estado_pago": {
      "type": "string",
      "enum": [
        "sin_hito",
        "bloqueado",
        "pendiente_revision",
        "aprobado"
      ],
      "default": "sin_hito"
    },
    "monto_contrato_usd": {
      "type": "number"
    },
    "subcontratista": {
      "type": "string"
    },
    "responsable": {
      "type": "string"
    },
    "hito_pago_porcentaje": {
      "type": "number"
    },
    "fuente_dato": {
      "type": "string",
      "enum": [
        "nupav",
        "agisoft",
        "csv",
        "manual"
      ],
      "default": "manual"
    },
    "notas": {
      "type": "string"
    },
    "mpa_lectura_actual": {
      "type": "number",
      "default": 0
    },
    "mpa_especificado": {
      "type": "number",
      "default": 0
    },
    "volumen_m3": {
      "type": "number",
      "default": 0
    },
    "tipo_hormigon": {
      "type": "string",
      "enum": [
        "estandar",
        "hormipurifica",
        "hormieco",
        "especial"
      ],
      "default": "estandar"
    },
    "sensor_id": {
      "type": "string"
    }
  },
  "required": [
    "proyecto_id",
    "nombre"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}