{
  "name": "InformeEjecutivo",
  "type": "object",
  "properties": {
    "proyecto_id": {
      "type": "string"
    },
    "periodo": {
      "type": "string"
    },
    "fecha_generacion": {
      "type": "string",
      "format": "date-time"
    },
    "resumen_ejecutivo": {
      "type": "string"
    },
    "riesgos_principales": {
      "type": "string"
    },
    "acciones_recomendadas": {
      "type": "string"
    },
    "estado_general": {
      "type": "string",
      "enum": [
        "verde",
        "amarillo",
        "rojo"
      ],
      "default": "verde"
    },
    "avance_real": {
      "type": "number"
    },
    "avance_programado": {
      "type": "number"
    },
    "desviacion": {
      "type": "number"
    },
    "nc_abiertas": {
      "type": "number"
    },
    "rdis_abiertos": {
      "type": "number"
    },
    "edps_bloqueados": {
      "type": "number"
    },
    "monto_bloqueado_usd": {
      "type": "number"
    },
    "alertas_criticas": {
      "type": "number"
    },
    "generado_por": {
      "type": "string"
    }
  },
  "required": [
    "proyecto_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}