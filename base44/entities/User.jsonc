{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "nombre_contacto": {
      "type": "string",
      "description": "Nombre completo declarado durante el registro"
    },
    "telefono": {
      "type": "string",
      "description": "Tel\u00e9fono personal para contacto y WhatsApp"
    },
    "cargo": {
      "type": "string",
      "description": "Cargo operacional en la obra",
      "enum": [
        "gerencia",
        "administrador_obra",
        "jefe_terreno",
        "jefe_calidad",
        "oficina_tecnica",
        "prevencionista",
        "capataz"
      ]
    },
    "empresa_nombre": {
      "type": "string",
      "description": "Nombre de empresa declarado durante el registro"
    },
    "empresa_id": {
      "type": "string",
      "description": "Empresa constructora a la que pertenece el usuario"
    },
    "proyectos_asignados": {
      "type": "array",
      "description": "IDs de obras asignadas al usuario",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "role"
  ]
}